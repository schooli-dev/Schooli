NODE_ENV=development
PORT=5000
PUBLIC_API_BASE_URL=http://localhost:5000/api

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:4200

DAILY_API_KEY=
DAILY_DOMAIN=your-domain.daily.co
DAILY_AUTO_CREATE_ROOMS=true
DAILY_ROOM_PRIVACY=private
DAILY_ENABLE_PREJOIN_UI=true
DAILY_ENABLE_CHAT=true
DAILY_ENABLE_RECORDING=off

# Cloudflare R2 (private learning-material uploads)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=schooliedu-learning-materials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MAX_UPLOAD_MB=25
